<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_corners_receiver"
        android:padding="8dp"
        android:layout_marginEnd="80dp"
        android:id = "@+id/left_chat_layout">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id = "@+id/left_chat_tv"
            android:textColor = "@color/white"
            android:textSize = "18sp"
            android:textColorLink="@color/white"
            />

        <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            xmlns:tools="http://schemas.android.com/tools"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/left_chat_image"
                android:layout_width="150dp"
                android:layout_height="150dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/left_play"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:elevation="8dp"
                android:src="@drawable/ic_play"
                app:layout_constraintStart_toStartOf="@+id/left_chat_image"
                app:layout_constraintTop_toTopOf="@+id/left_chat_image"
                android:background="@null"
                android:visibility="gone"/>

        </androidx.constraintlayout.widget.ConstraintLayout>


    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_corners_sender"
        android:layout_alignParentEnd="true"
        android:padding="8dp"
        android:layout_marginStart="80dp"
        android:id = "@+id/right_chat_layout">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor = "@color/white"
            android:textSize = "18sp"
            android:id = "@+id/right_chat_tv"
            android:textColorLink="@color/white" />


        <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            xmlns:tools="http://schemas.android.com/tools"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/right_chat_image"
                android:layout_width="150dp"
                android:layout_height="150dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/right_play"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:elevation="8dp"
                android:src="@drawable/ic_play"
                app:layout_constraintStart_toStartOf="@+id/right_chat_image"
                app:layout_constraintTop_toTopOf="@+id/right_chat_image"
                android:background="@null"
                android:visibility="gone"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

</RelativeLayout>